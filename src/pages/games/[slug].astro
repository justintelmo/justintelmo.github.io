---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ContactLinks from '../../components/ContactLinks.astro';
import Footer from '../../components/Footer.astro';
import GameGlance from '../../components/GameGlance.astro';
import ResumeButton from '../../components/ResumeButton.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { site } from '../../data/site';
import Base from '../../layouts/Base.astro';
import { adjacentProjects, projectPath, sortProjects } from '../../lib/projects';

// Same filter as the home page cards, so every card has a page and hidden projects have none.
export async function getStaticPaths() {
  const projects = sortProjects(await getCollection('projects'));
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, ...adjacentProjects(projects, project.id) },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  previous?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, previous, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
// The NDA page never shows an image, even if one slips into its frontmatter.
const image = data.nda ? undefined : data.images[0];
---

<Base title={`${data.title} | ${site.name}`} description={data.summary}>
  <SiteHeader name={site.name} />
  <main class="container">
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>
    <div class="layout">
      <div class="hero">
        {
          image ? (
            <figure>
              <Image
                src={image.src as ImageMetadata}
                alt={image.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 48rem) 40rem, 100vw"
              />
              <figcaption>
                <a href={image.attribution}>
                  Image source<span class="visually-hidden"> for {data.title}</span>
                </a>
              </figcaption>
            </figure>
          ) : (
            <div class="image-placeholder" role="img" aria-label="Unreleased game, no public screenshots">
              Unreleased
            </div>
          )
        }
      </div>
      <div class="side"><GameGlance project={project} /></div>
      <div class="case-study"><Content /></div>
    </div>
    <nav class="more-games" aria-label="More games">
      {
        previous && (
          <a href={projectPath(previous)} rel="prev">
            <span class="direction">← Previous</span>
            <span class="title">{previous.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a href={projectPath(next)} rel="next">
            <span class="direction">Next →</span>
            <span class="title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
    <div class="talk">
      <p>Want to talk about this work?</p>
      <ResumeButton />
      <ContactLinks links={site.links.filter((link) => link.icon !== 'resume')} />
    </div>
  </main>
  <Footer note={site.contactNote} links={site.links} />
</Base>

<style>
  h1 {
    margin: 2.5rem 0 0;
    font-size: var(--size-section-heading);
    line-height: 1.2;
  }

  .lede {
    margin: 0.5rem 0 0;
    max-width: 65ch;
    font-size: var(--size-lead);
    color: var(--text-muted);
  }

  /* Phones stack image, facts, then story. Wider screens put the facts in a sticky sidebar. */
  .layout {
    display: grid;
    grid-template-areas: 'hero' 'side' 'body';
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 17rem;
      grid-template-areas: 'hero side' 'body side';
      column-gap: 3rem;
    }

    /* The one-row sticky header is 4.5rem tall at this width, plus a little air. */
    .side {
      position: sticky;
      top: 5.5rem;
      align-self: start;
    }
  }

  .hero {
    grid-area: hero;
  }

  .side {
    grid-area: side;
  }

  .case-study {
    grid-area: body;
    max-width: 65ch;
  }

  figure {
    margin: 0;
  }

  /* Natural shape, capped so a portrait store screenshot doesn't fill the screen. */
  figure img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 28rem;
    border-radius: 0.5rem;
    background: var(--surface);
  }

  figcaption {
    font-size: var(--size-small);
  }

  figcaption a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--size-lead);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .more-games {
    display: grid;
    gap: 1rem;
    margin-top: 4rem;
  }

  @media (min-width: 48rem) {
    .more-games {
      grid-template-columns: 1fr 1fr;
    }
  }

  .more-games a {
    display: flex;
    flex-direction: column;
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
  }

  .more-games a:hover {
    text-decoration: underline;
  }

  /* Pinned to the right column even when there's no "previous" beside it. */
  .more-games a[rel='next'] {
    grid-column: -2;
    text-align: right;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--size-subheading);
    line-height: 1.2;
  }

  .direction {
    font-size: var(--size-small);
    font-weight: 400;
    color: var(--text-muted);
  }

  .talk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2.5rem;
  }

  .talk p {
    margin: 0;
    flex-basis: 100%;
    font-size: var(--size-lead);
  }

  @media (min-width: 48rem) {
    .talk p {
      flex-basis: auto;
    }
  }

  .case-study > :global(:first-child) {
    margin-top: 0;
  }

  .case-study :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: var(--size-subheading);
  }

  .case-study :global(h3) {
    margin: 1.75rem 0 0.25rem;
    font-size: var(--size-lead);
  }

  .case-study :global(p) {
    margin: 0.5rem 0 0;
  }
</style>
