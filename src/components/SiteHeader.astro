---
import { Image } from 'astro:assets';
import logo from '../assets/Avi2.png';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;

// Rooted at "/" so the same nav works from pages other than home.
const sections = [
  { label: 'Games', href: '/#games' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="site-header">
  <div class="bar container">
    <a class="name" href="/">
      <Image src={logo} alt="" width={32} height={32} class="avatar" loading="eager" />
      {name}
    </a>
    <nav aria-label="Sections">
      <ul>
        {
          sections.map((section) => (
            <li>
              <a href={section.href}>{section.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button resume" href="/resume.pdf" target="_blank" rel="noopener"
      >Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span></a
    >
    <div class="toggle"><ThemeToggle /></div>
  </div>
</header>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.site-header nav a')];
  // Only links into this page have sections to track. Elsewhere the nav just navigates.
  const tracked = links.flatMap((link) => {
    const section = link.pathname === location.pathname ? document.getElementById(link.hash.slice(1)) : null;
    return section ? [{ link, section }] : [];
  });

  // The section the visitor last jumped to with a link, until they scroll by hand.
  let jumpedHash = location.hash;

  // The current section is the last one whose top has passed a line a third of the way down the screen.
  // The last few sections are short, so the page runs out before their tops get that high. Over the last
  // screenful of scrolling the line slides down to the bottom of the screen, so each of them gets a turn.
  // In that stretch a section the visitor jumped to wins while it's on screen, or the link they clicked
  // could light up its neighbor.
  const update = () => {
    const remaining = document.documentElement.scrollHeight - window.innerHeight - window.scrollY;
    const slide = Math.max(0, 1 - remaining / window.innerHeight);
    const line = (window.innerHeight / 3) * (1 + 2 * slide);
    const jumpedTo = tracked.find(({ section }) => `#${section.id}` === jumpedHash);
    const onScreen = (section: HTMLElement) => section.getBoundingClientRect().top < window.innerHeight;
    const current =
      slide > 0 && jumpedTo && onScreen(jumpedTo.section)
        ? jumpedTo
        : tracked.findLast(({ section }) => section.getBoundingClientRect().top <= line);
    for (const { link } of tracked) {
      if (link === current?.link) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };

  if (tracked.length > 0) {
    window.addEventListener('scroll', update, { passive: true });
    // A jump that doesn't scroll (already at the bottom) still changes which section was asked for.
    // Click as well as hashchange: clicking the link already in the URL changes no hash.
    window.addEventListener('hashchange', () => {
      jumpedHash = location.hash;
      update();
    });
    for (const { link } of tracked) {
      link.addEventListener('click', () => {
        jumpedHash = link.hash;
        update();
      });
    }
    for (const type of ['wheel', 'touchmove', 'keydown']) {
      window.addEventListener(type, () => (jumpedHash = ''), { passive: true });
    }
    update();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
  }

  /* Phones: name, resume, and toggle on top, section links in a row below that scrolls sideways if needed.
     The 48rem breakpoint and the header heights are mirrored by scroll-padding-top in global.css. */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'name resume toggle'
      'nav nav nav';
    align-items: center;
    gap: 0 0.75rem;
    padding-block: 0.25rem;
  }

  @media (min-width: 48rem) {
    .bar {
      grid-template-columns: auto 1fr auto auto;
      grid-template-areas: 'name nav resume toggle';
    }

    nav ul {
      justify-content: flex-end;
    }
  }

  .name {
    grid-area: name;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  nav {
    grid-area: nav;
    min-width: 0;
    overflow-x: auto;
  }

  nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    color: var(--text-muted);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--accent-magenta);
  }

  /* An underline as well as a color change, so the current section doesn't rely on color alone. */
  nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0.5rem;
    bottom: 0.55rem;
    height: 2px;
    background: var(--accent-magenta);
    transform: scaleX(0);
    transform-origin: left;
  }

  nav a:hover::after,
  nav a[aria-current]::after {
    transform: scaleX(1);
  }

  nav a[aria-current] {
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    nav a::after {
      transition: transform 200ms;
    }
  }

  .resume {
    grid-area: resume;
  }

  .toggle {
    grid-area: toggle;
  }
</style>
