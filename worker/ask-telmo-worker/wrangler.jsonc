{
	"name": "ask-telmo-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-10",
	"observability": {
		"enabled": true,
	},
	// Set with `wrangler secret put` in a real terminal, never in this file.
	"secrets": {
		"required": ["ANTHROPIC_API_KEY"],
	},
	"vars": {
		"CONTEXT_URL": "https://justintelmo.github.io/ask-context.txt",
		// Questions per UTC day. At about $0.001 a question, 150 a day stays under the $5 monthly spend cap.
		"DAILY_LIMIT_PER_IP": 20,
		"DAILY_LIMIT_TOTAL": 150,
	},
	"durable_objects": {
		"bindings": [{ "name": "DAILY_QUOTA", "class_name": "DailyQuota" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyQuota"] }],
	// Per IP. The binding only counts over 10 or 60 seconds; DAILY_QUOTA handles the daily caps.
	"ratelimits": [
		{
			"name": "CHAT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 },
		},
	],
}
