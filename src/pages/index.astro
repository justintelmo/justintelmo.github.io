---
import { getCollection } from 'astro:content';
import FeaturedProject from '../components/FeaturedProject.astro';
import Footer from '../components/Footer.astro';
import IntroHeader from '../components/IntroHeader.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkillList from '../components/SkillList.astro';
import Spotlight from '../components/Spotlight.astro';
import { site } from '../data/site';
import { skillGroups } from '../data/skills';
import Base from '../layouts/Base.astro';
import { sortGames } from '../lib/games';

const featured = sortGames(await getCollection('games'));
---

<Base title={site.name} description={site.tagline}>
  <SiteHeader name={site.name} />
  <main class="container">
    <IntroHeader site={site} projects={featured} />
    <section id="games" aria-labelledby="games-heading">
      <h2 id="games-heading">Games</h2>
      <Spotlight projects={featured} />
      <div class="featured">
        {featured.map((project) => <FeaturedProject project={project} />)}
      </div>
    </section>
    <section id="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <SkillList groups={skillGroups} />
    </section>
  </main>
  <Footer note={site.contactNote} links={site.links} />
</Base>

<style>
  h2 {
    margin: 4rem 0 1.5rem;
    font-size: var(--size-section-heading);
  }

  /* The intro already supplies space above the first section. */
  :global(.intro) + section > h2 {
    margin-top: 2rem;
  }

  .featured {
    display: grid;
    gap: 3rem 2rem;
  }

  @media (min-width: 40rem) {
    .featured {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .featured {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
