---
import type { skillGroups } from '../data/skills';

interface Props {
  groups: typeof skillGroups;
}

const { groups } = Astro.props;
---

<div class="groups">
  {
    groups.map((group) => (
      <div>
        <h3>{group.name}</h3>
        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem 2rem;
  }

  h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    color: var(--accent-lavender);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
