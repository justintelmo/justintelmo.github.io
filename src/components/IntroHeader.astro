---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import logo from '../assets/Avi2.png';
import type { site as siteData } from '../data/site';
import { heroArt, projectPath } from '../lib/projects';
import ContactLinks from './ContactLinks.astro';
import ResumeButton from './ResumeButton.astro';

interface Props {
  site: typeof siteData;
  projects: CollectionEntry<'games'>[];
}

const { site, projects } = Astro.props;
const words = site.name.split(' ');
// The Resume button already links the PDF, so the contact links beside it leave it out.
const links = site.links.filter((link) => link.icon !== 'resume');
const art = heroArt(projects);
---

<div class="intro">
  <div class="text">
    <div class="top-row">
      <Image src={logo} alt="" width={96} height={96} class="logo" loading="eager" />
      <!-- One word per line. The space between the spans keeps the accessible name "Justin Telmo". -->
      <h1>{words.map((word, i) => <>{i > 0 && ' '}<span>{word}</span></>)}</h1>
    </div>
    <div class="body">
      <p class="tagline">{site.tagline}</p>
      <p class="facts">{site.facts.join(' · ')}</p>
      <!-- One call to action, then the direct contact links. They share a row when it fits. -->
      <div class="actions">
        <ResumeButton />
        <ContactLinks links={links} />
      </div>
    </div>
  </div>
  <ul class="art">
    {
      art.map((project) => (
        <li>
          <a href={projectPath(project)} aria-label={project.data.title}>
            <Image
              src={project.data.images[0].src as ImageMetadata}
              alt={project.data.images[0].alt}
              widths={[260, 520]}
              sizes="(min-width: 48rem) clamp(9rem, 20vw, 16.25rem), 32vw"
              loading="eager"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Measures where the hero avatar has to fly to land on the header avatar (see `.intro .logo` in global.css).
  // The row's height changes when Archivo loads, which moves the end of the flight, so it is watched too.
  const logo = document.querySelector<HTMLElement>('.intro .logo');
  const row = document.querySelector<HTMLElement>('.intro .top-row');
  const target = document.querySelector<HTMLElement>('.site-header .avatar');

  if (logo && row && target) {
    const measure = () => {
      // The avatar's own spot, without the flight's transform.
      logo.style.animation = 'none';
      const from = logo.getBoundingClientRect();
      logo.style.animation = '';
      // The sticky header never moves, so its avatar's spot holds at any scroll position.
      const to = target.getBoundingClientRect();
      const inset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);
      // The scroll position where the row has slid fully under the header.
      const end = row.getBoundingClientRect().bottom + window.scrollY - inset;
      logo.style.setProperty('--fly-x', `${to.left - from.left}px`);
      logo.style.setProperty('--fly-y', `${to.top - (from.top + window.scrollY - end)}px`);
    };

    new ResizeObserver(measure).observe(row);
    window.addEventListener('resize', measure);
  }
</script>

<style>
  .intro {
    padding-block: 1.5rem 1rem;
  }

  .top-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .logo {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border-radius: 50%;
  }

  h1 {
    margin: 0;
    font-size: var(--size-display);
    font-variation-settings: 'wdth' 75;
    font-weight: 800;
    line-height: 0.9;
  }

  h1 span {
    display: block;
  }

  /* A lead line under the name, so it shares the name's typeface at normal width. */
  .tagline {
    margin: 1.25rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: var(--size-subheading);
    font-weight: 500;
    line-height: 1.3;
  }

  .facts {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 1.25rem 0 0.5rem;
  }

  /* The hero's call to action, a step up from the default button. */
  .actions :global(.button) {
    min-height: 3rem;
    padding: 0 1.25rem;
    font-size: var(--size-body);
  }

  /* The fan. All four cards share one grid cell and are pushed sideways and turned from there.
     --w is the card width; --x is each card's slot in the fan, in steps of --step card widths;
     --r is its angle, scaled by --turn. Hover and focus raise --step and --turn to spread it.
     The list is wide enough for the spread fan, so the cards never reach past it. */
  .art {
    --w: 32vw;
    --step: 0.2;
    --turn: 0.6;
    display: grid;
    place-items: center;
    width: calc(var(--w) * 2.2);
    margin: 2rem auto 1rem;
    padding: calc(var(--w) * 0.12) 0;
    list-style: none;
  }

  /* The <li> boxes stay stacked in the middle while their cards move out sideways, so an empty
     <li> would sit over a neighbor's visible card and swallow its clicks. Only the cards take the pointer. */
  .art li {
    grid-area: 1 / 1;
    width: var(--w);
    pointer-events: none;
  }

  /* First project in front. The order never changes, even on hover: a raised card would cover
     its neighbors and hold the pointer, so moving across the fan would feel different each way. */
  .art li:nth-child(1) {
    --x: -1.5;
    --r: -8deg;
    --drift: -2rem;
    z-index: 4;
  }

  .art li:nth-child(2) {
    --x: -0.5;
    --r: -3deg;
    --drift: -4rem;
    z-index: 3;
  }

  .art li:nth-child(3) {
    --x: 0.5;
    --r: 3deg;
    --drift: -3rem;
    z-index: 2;
  }

  .art li:nth-child(4) {
    --x: 1.5;
    --r: 7deg;
    --drift: -5rem;
    z-index: 1;
  }

  /* Rotation and spread live on the link; the scroll drift lives on the <li>, so the two
     transforms never overwrite each other. */
  .art a {
    display: block;
    pointer-events: auto;
    border-radius: 0.75rem;
    transform: translate(calc(var(--x) * var(--step) * var(--w)), var(--lift, 0rem)) rotate(calc(var(--r) * var(--turn)));
  }

  .art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.75rem;
    background: var(--surface);
  }

  @media (min-width: 48rem) {
    .intro {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }

    .art {
      --w: clamp(9rem, 20vw, 16.25rem);
      --step: 0.28;
      --turn: 1;
      width: calc(var(--w) * 2.6);
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrance: the name, then the text, then the cards settle into the fan. About 700ms in all.
       Backwards fill only: once a card lands, its own transform takes over again, so the spread
       transition still works. */
    h1,
    .body,
    .art a {
      animation-duration: 350ms;
      animation-timing-function: ease-out;
      animation-fill-mode: backwards;
    }

    h1 {
      animation-name: rise-in;
    }

    .body {
      animation-name: rise-in;
      animation-delay: 100ms;
    }

    .art a {
      animation-name: card-in;
      transition-property: transform;
      transition-duration: 250ms;
      transition-timing-function: ease-out;
    }

    .art li:nth-child(1) a {
      animation-delay: 200ms;
    }

    .art li:nth-child(2) a {
      animation-delay: 250ms;
    }

    .art li:nth-child(3) a {
      animation-delay: 300ms;
    }

    .art li:nth-child(4) a {
      animation-delay: 350ms;
    }

    /* Spread: the fan opens on hover or keyboard focus, and the hovered or focused card lifts in place. */
    .art:hover,
    .art:focus-within {
      --step: 0.3;
      --turn: 1;
    }

    @media (min-width: 48rem) {
      .art:hover,
      .art:focus-within {
        --step: 0.4;
        --turn: 1.5;
      }
    }

    .art a:hover,
    .art a:focus-visible {
      --lift: -0.75rem;
    }

    /* Drift: as the hero scrolls away, each card rises at its own rate. Two columns only:
       stacked on phones, the cards would rise over the contact links and take their taps. */
    @supports (animation-timeline: view()) {
      @media (min-width: 48rem) {
        .intro {
          view-timeline-name: --intro;
        }

        .art li {
          animation-name: drift;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: --intro;
          animation-range: exit;
        }
      }
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* Lower and unrotated, matching the shape of the card's own transform so it interpolates cleanly. */
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translate(0, 2rem) rotate(0deg);
    }
  }

  @keyframes drift {
    to {
      transform: translateY(var(--drift));
    }
  }
</style>
