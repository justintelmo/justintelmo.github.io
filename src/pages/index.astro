---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import Footer from '../components/Footer.astro';
import IntroHeader from '../components/IntroHeader.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkillTimeline from '../components/SkillTimeline.astro';
import { site } from '../data/site';
import { skillGroups } from '../data/skills';
import Base from '../layouts/Base.astro';
import { sortProjects } from '../lib/projects';

const featured = sortProjects(await getCollection('projects'));
---

<Base title={site.name} description={site.tagline}>
  <SiteHeader name={site.name} />
  <main class="container">
    <IntroHeader site={site} projects={featured} />
    <section id="about" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <About text={site.about} />
    </section>
    <section id="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Projects</h2>
      <div class="featured">
        {featured.map((project) => <FeaturedProject project={project} />)}
      </div>
    </section>
    <section id="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <SkillTimeline groups={skillGroups} projects={featured} />
    </section>
  </main>
  <Footer note={site.contactNote} links={site.links} />
</Base>

<style>
  h2 {
    margin: 4rem 0 1.5rem;
    font-size: var(--size-section-heading);
  }

  /* The intro already supplies space above the first section. */
  :global(.intro) + section > h2 {
    margin-top: 2rem;
  }

  .featured {
    display: grid;
    gap: 3rem 2rem;
  }

  @media (min-width: 40rem) {
    .featured {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .featured {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
