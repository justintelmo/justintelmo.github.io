---
import { type CollectionEntry, render } from 'astro:content';
import { formatDateRange } from '../lib/dates';
import { projectAnchor } from '../lib/projects';

interface Props {
  job: CollectionEntry<'jobs'>;
  projects: CollectionEntry<'projects'>[];
}

const { job, projects } = Astro.props;
const { Content } = await render(job);
// With one project, "See the project" is enough. With several, each link names its game.
const several = projects.length > 1;
---

<li class="stop">
  <h3>{job.data.studio}</h3>
  <p class="meta">
    {job.data.role} · {formatDateRange(job.data.from, job.data.to)}
  </p>
  <div class="story"><Content /></div>
  <ul class="links">
    {
      projects.map((project) => (
        <li>
          <a href={`#${projectAnchor(project)}`}>
            {several ? `See ${project.data.title}` : 'See the project'}
          </a>
        </li>
      ))
    }
  </ul>
</li>

<style>
  .stop {
    position: relative;
    padding-left: 2rem;
  }

  /* Dot on the rail drawn by JourneyTimeline. */
  .stop::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: -0.4rem;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--accent-magenta);
    border-radius: 50%;
    background: var(--bg);
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .meta {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
  }

  .story {
    max-width: 65ch;
  }

  .story :global(p) {
    margin: 0.5rem 0 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
</style>
