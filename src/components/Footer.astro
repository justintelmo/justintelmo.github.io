---
import type { SiteLink } from '../data/site';
import ContactLinks from './ContactLinks.astro';

interface Props {
  note: string;
  links: SiteLink[];
}

const { note, links } = Astro.props;
// Shown as text too, so visitors who use webmail can copy it instead of opening a mail app.
const email = links.find((link) => link.icon === 'email')?.href.replace(/^mailto:/, '');
---

<!-- Doubles as the Contact section, so every page ends with a way to reach Justin. -->
<footer id="contact" class="container" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Contact</h2>
  <p>{note}</p>
  {email && <address class="email">{email}</address>}
  <ContactLinks links={links} />
</footer>

<style>
  footer {
    margin-top: 4rem;
    padding-block: 2rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
  }

  p {
    max-width: 65ch;
    margin: 0 0 0.5rem;
  }

  .email {
    margin: 0 0 0.5rem;
    font-style: normal;
    font-weight: 600;
  }
</style>
