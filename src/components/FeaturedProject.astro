---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatYearRange } from '../lib/dates';
import { projectAnchor, projectPath } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
// The NDA card never shows an image, even if one slips into its frontmatter.
// Image credits live on the game page, since a second link would fight the card-wide link.
const image = data.nda ? undefined : data.images[0];
---

<article id={projectAnchor(project)} class="project">
  <div class="media">
    {
      image ? (
        <Image
          src={image.src as ImageMetadata}
          alt={image.alt}
          widths={[480, 800]}
          sizes="(min-width: 640px) 31rem, 100vw"
          loading="lazy"
        />
      ) : (
        <div class="image-placeholder" role="img" aria-label="Unreleased game, no public screenshots">
          Unreleased
        </div>
      )
    }
  </div>
  <p class="years">{formatYearRange(data.workedFrom, data.workedTo)}</p>
  <h3><a href={projectPath(project)}>{data.title}</a></h3>
  <p class="role">{data.role} · {data.studio}</p>
  <p class="summary">{data.summary}</p>
  <!-- Not a link: the title already links the whole card, and screen readers would hear "Read more" seven times. -->
  <p class="more" aria-hidden="true">Read more →</p>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* One frame shape for every card. Portrait store screenshots letterbox instead of towering or cropping. */
  .media img,
  .image-placeholder {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
  }

  .media {
    margin-bottom: 0.75rem;
  }

  .media img {
    object-fit: contain;
  }

  .image-placeholder {
    display: grid;
    place-items: center;
    color: var(--text-muted);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  /* Stretches the title link over the whole card, so a click anywhere opens the game page. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
  }

  h3 a:focus-visible {
    outline: none;
  }

  h3 a:focus-visible::after {
    outline: 2px solid var(--accent-magenta);
    outline-offset: 4px;
  }

  .project:hover h3 a {
    color: var(--accent-magenta);
  }

  .years,
  .role,
  .summary,
  .more {
    margin: 0;
  }

  .role {
    color: var(--text-muted);
  }

  .years {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .more {
    margin-top: 0.25rem;
    color: var(--accent-blue);
    font-weight: 600;
  }

  .project:hover .more {
    color: var(--accent-magenta);
  }
</style>
