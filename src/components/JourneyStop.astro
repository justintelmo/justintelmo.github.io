---
import type { CollectionEntry } from 'astro:content';
import { formatDateRange } from '../lib/dates';
import { projectPath } from '../lib/projects';

interface Props {
  job: CollectionEntry<'jobs'>;
  projects: CollectionEntry<'projects'>[];
}

const { job, projects } = Astro.props;
// The job's Markdown story isn't rendered. The game pages tell it now, and keeping it in the file
// makes it easy to bring back.
---

<li class="stop">
  <h3>{job.data.studio}</h3>
  <p class="meta">
    {job.data.role} · {formatDateRange(job.data.from, job.data.to)}
  </p>
  <ul class="links">
    {
      projects.map((project) => (
        <li>
          <a href={projectPath(project)}>{project.data.title}</a>
        </li>
      ))
    }
  </ul>
</li>

<style>
  .stop {
    position: relative;
    padding-left: 2rem;
  }

  /* Dot on the rail drawn by JourneyTimeline. */
  .stop::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: -0.4rem;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--accent-magenta);
    border-radius: 50%;
    background: var(--bg);
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .meta {
    margin: 0.15rem 0 0;
    color: var(--text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
</style>
