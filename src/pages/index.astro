---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import Footer from '../components/Footer.astro';
import IntroHeader from '../components/IntroHeader.astro';
import JourneyTimeline from '../components/JourneyTimeline.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Toolbox from '../components/Toolbox.astro';
import { site } from '../data/site';
import { skillGroups } from '../data/skills';
import Base from '../layouts/Base.astro';
import { resolveJobProjects, sortJobs, sortProjects } from '../lib/projects';

const featured = sortProjects(await getCollection('projects'));
// Resolving against the cards means a job that names a missing or hidden project fails the build.
const journey = sortJobs(await getCollection('jobs')).map((job) => ({ job, projects: resolveJobProjects(job, featured) }));
---

<Base title={site.name} description={site.tagline}>
  <IntroHeader site={site}>
    <ThemeToggle />
  </IntroHeader>
  <main class="container">
    <section id="about" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <About text={site.about} />
    </section>
    <section id="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Projects</h2>
      <div class="featured">
        {featured.map((project, index) => <FeaturedProject project={project} reverse={index % 2 === 1} />)}
      </div>
    </section>
    <section id="experience" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <JourneyTimeline stops={journey} />
    </section>
    <section id="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <Toolbox groups={skillGroups} />
    </section>
  </main>
  <Footer links={site.links} />
</Base>

<style>
  h2 {
    margin: 4rem 0 1.5rem;
    font-size: 1.75rem;
  }

  /* The header already supplies space above the first section. */
  main > section:first-child > h2 {
    margin-top: 2rem;
  }

  .featured {
    display: grid;
    gap: 3.5rem;
  }
</style>
