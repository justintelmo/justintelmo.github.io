---
import Icon from './Icon.astro';
---

<!-- The PDF tag is for sighted visitors; the hidden text tells screen readers the same and that a tab opens. -->
<a class="button primary resume-button" href="/resume.pdf" target="_blank" rel="noopener">
  <Icon name="resume" />
  Resume
  <span class="tag" aria-hidden="true">PDF</span>
  <span class="visually-hidden"> (PDF, opens in a new tab)</span>
</a>

<style>
  .resume-button {
    gap: 0.5rem;
  }

  .tag {
    padding: 0.05em 0.35em;
    border: 1px solid currentColor;
    border-radius: 0.25rem;
    font-size: 0.7em;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }
</style>
